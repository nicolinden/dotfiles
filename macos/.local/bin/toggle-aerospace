#!/usr/bin/env bash

set -euo pipefail

AEROSPACE_BIN="$(command -v aerospace 2>/dev/null || true)"
if [[ -z "$AEROSPACE_BIN" && -x /opt/homebrew/bin/aerospace ]]; then
  AEROSPACE_BIN=/opt/homebrew/bin/aerospace
elif [[ -z "$AEROSPACE_BIN" && -x /usr/local/bin/aerospace ]]; then
  AEROSPACE_BIN=/usr/local/bin/aerospace
fi

[[ -n "$AEROSPACE_BIN" ]] || exit 1

SKETCHYBAR_BIN="$(command -v sketchybar 2>/dev/null || true)"
if [[ -z "$SKETCHYBAR_BIN" && -x /opt/homebrew/bin/sketchybar ]]; then
  SKETCHYBAR_BIN=/opt/homebrew/bin/sketchybar
elif [[ -z "$SKETCHYBAR_BIN" && -x /usr/local/bin/sketchybar ]]; then
  SKETCHYBAR_BIN=/usr/local/bin/sketchybar
fi

AEROSPACE_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/Library/Caches}/aerospace"
AEROSPACE_STATE_FILE="$AEROSPACE_CACHE_DIR/enabled-state"
TOGGLE_LOCK_FILE="$AEROSPACE_CACHE_DIR/toggle.lock"

mkdir -p "$AEROSPACE_CACHE_DIR"
lock_acquired=false
for _ in {1..100}; do
  if shlock -f "$TOGGLE_LOCK_FILE" -p $$; then
    lock_acquired=true
    break
  fi
  sleep 0.05
done
[[ "$lock_acquired" == true ]] || {
  echo "AeroSpace toggle is still busy." >&2
  exit 1
}
trap 'rm -f "$TOGGLE_LOCK_FILE"' EXIT

BORDERS_BIN="$(command -v borders 2>/dev/null || true)"
if [[ -z "$BORDERS_BIN" && -x /opt/homebrew/bin/borders ]]; then
  BORDERS_BIN=/opt/homebrew/bin/borders
elif [[ -z "$BORDERS_BIN" && -x /usr/local/bin/borders ]]; then
  BORDERS_BIN=/usr/local/bin/borders
fi

BORDERS_SERVICE="gui/$(id -u)/sh.brew.borders"
BORDERS_PLIST="$HOME/Library/LaunchAgents/sh.brew.borders.plist"
BORDERS_CONFIG="$HOME/.config/borders/bordersrc"

ensure_borders_running() {
  [[ -n "$BORDERS_BIN" ]] || return 0
  if ! launchctl print "$BORDERS_SERVICE" >/dev/null 2>&1; then
    [[ -f "$BORDERS_PLIST" ]] || return 1
    launchctl bootstrap "gui/$(id -u)" "$BORDERS_PLIST" >/dev/null 2>&1 || true
    launchctl kickstart "$BORDERS_SERVICE" >/dev/null 2>&1 || true
  fi
  launchctl print "$BORDERS_SERVICE" >/dev/null 2>&1
}

show_borders() {
  [[ -n "$BORDERS_BIN" ]] || return 0
  ensure_borders_running
  if [[ -x "$BORDERS_CONFIG" ]]; then
    "$BORDERS_CONFIG"
  else
    "$BORDERS_BIN" active_color=0xffffc857 inactive_color=0x00000000
  fi
}

hide_borders() {
  [[ -n "$BORDERS_BIN" ]] || return 0
  # Updating the running daemon is immediate and avoids slow, racy launchd
  # unregister/register cycles. Both colors are fully transparent.
  if launchctl print "$BORDERS_SERVICE" >/dev/null 2>&1; then
    "$BORDERS_BIN" active_color=0x00000000 inactive_color=0x00000000
  fi
}

# A disabled AeroSpace server rejects status commands, but still accepts
# `enable on`. If the app was actually quit, launch it and retry that command.
if ! "$AEROSPACE_BIN" list-modes >/dev/null 2>&1; then
  if ! "$AEROSPACE_BIN" enable on >/dev/null 2>&1; then
    open -a AeroSpace
    enabled=false
    for _ in {1..30}; do
      if "$AEROSPACE_BIN" enable on >/dev/null 2>&1; then
        enabled=true
        break
      fi
      sleep 0.1
    done
    if [[ "$enabled" != true ]]; then
      echo "Could not start AeroSpace." >&2
      exit 1
    fi
  fi
  mkdir -p "$AEROSPACE_CACHE_DIR"
  printf 'enabled\n' > "$AEROSPACE_STATE_FILE"
  if [[ -n "$SKETCHYBAR_BIN" ]]; then
    "$SKETCHYBAR_BIN" \
      --set '/workspace_group\..*/' drawing=on \
      --trigger aerospace_workspace_change
  fi
  show_borders
  echo "AeroSpace and Borders enabled."
  exit 0
fi

if "$AEROSPACE_BIN" enable off --fail-if-noop; then
  mkdir -p "$AEROSPACE_CACHE_DIR"
  printf 'disabled\n' > "$AEROSPACE_STATE_FILE"
  if [[ -n "$SKETCHYBAR_BIN" ]]; then
    "$SKETCHYBAR_BIN" \
      --set '/workspace\..*/' drawing=off \
      --set '/workspace_group\..*/' drawing=off
  fi
  hide_borders
  echo "AeroSpace disabled and Borders hidden."
elif "$AEROSPACE_BIN" enable on --fail-if-noop; then
  mkdir -p "$AEROSPACE_CACHE_DIR"
  printf 'enabled\n' > "$AEROSPACE_STATE_FILE"
  if [[ -n "$SKETCHYBAR_BIN" ]]; then
    "$SKETCHYBAR_BIN" \
      --set '/workspace_group\..*/' drawing=on \
      --trigger aerospace_workspace_change
  fi
  show_borders
  echo "AeroSpace and Borders enabled."
else
  echo "Could not change the AeroSpace state; Borders was left unchanged." >&2
  exit 1
fi
