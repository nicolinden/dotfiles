#!/usr/bin/env bash

set -euo pipefail

hidden_state="$(sketchybar --query bar | sed -n 's/.*"hidden": "\([^"]*\)".*/\1/p' | head -n 1)"

if [[ "$hidden_state" == "on" ]]; then
  # SketchyBar terug: hij bedekt de permanent zichtbare native menubalk.
  # `topmost=on` is belangrijk: `off` laat AeroSpace-vensters over de balk
  # heen tekenen.
  sketchybar --bar topmost=on hidden=off
else
  # De native menubalk is in macOS ingesteld op "Nooit verbergen".  Deze
  # verschijnt meteen zodra SketchyBar verdwijnt.  Wijzig die macOS-instelling
  # niet hier: Tahoe past `defaults` pas na app-herstarts toe.
  sketchybar --bar topmost=on hidden=on
fi
