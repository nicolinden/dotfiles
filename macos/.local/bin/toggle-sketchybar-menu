#!/usr/bin/env bash

set -euo pipefail

hidden_state="$(sketchybar --query bar | sed -n 's/.*"hidden": "\([^"]*\)".*/\1/p' | head -n 1)"

if [[ "$hidden_state" == "on" ]]; then
  # SketchyBar terug: verberg de native balk weer automatisch.
  defaults write -g _HIHideMenuBar -bool true
  killall SystemUIServer 2>/dev/null || true
  sketchybar --bar hidden=off
else
  # SketchyBar weg: maak de echte macOS-menubalk permanent zichtbaar, niet
  # alleen wanneer de muis de bovenrand raakt.
  defaults write -g _HIHideMenuBar -bool false
  killall SystemUIServer 2>/dev/null || true
  sketchybar --bar hidden=on
fi
