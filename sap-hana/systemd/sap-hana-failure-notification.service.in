[Unit]
Description=Send a test Home Assistant notification for SAP HANA/PlayNext
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
ExecStart=@HOME@/.local/share/sap-hana-automation/notify-ha.sh "Testmelding: SAP HANA/PlayNext webhook werkt." info 0
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
TimeoutStartSec=30s
