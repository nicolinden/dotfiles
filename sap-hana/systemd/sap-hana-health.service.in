[Unit]
Description=Check public SAP HANA/PlayNext application health
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
WorkingDirectory=@HOME@/.local/share/sap-hana-automation
ExecStart=@HOME@/.local/share/sap-hana-automation/monitor-health.sh
Environment=HOME=@HOME@
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@HOME@/.local/share/sap-hana-automation/state
TimeoutStartSec=90s
