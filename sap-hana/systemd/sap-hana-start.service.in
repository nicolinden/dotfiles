[Unit]
Description=Start SAP HANA Cloud Trial and PlayNext applications
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
OnFailure=sap-hana-failure-notification.service

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
WorkingDirectory=@HOME@/.local/share/sap-hana-automation
ExecStart=@HOME@/.local/share/sap-hana-automation/start-hana.sh
Environment=HOME=@HOME@
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
TimeoutStartSec=25min
